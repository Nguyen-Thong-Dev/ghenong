# Cổng chạy dịch vụ cục bộ (mặc định 3008)
PORT=3008

# Giọng đọc tiếng Việt (Edge TTS)
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_PITCH=+4%

# Đặt DISABLE_SIM=1 khi vận hành live thật để tắt toàn bộ các API giả lập (/api/sim/*)
DISABLE_SIM=0

# Khóa API miễn phí từ https://www.eulerstream.com (tạo khi mạng bị báo lỗi 401 Anonymous access)
TIKTOK_SIGN_API_KEY=
